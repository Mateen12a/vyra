# Copy to .env and fill in; `python -m person_studio` loads .env automatically.
PERSON_DATA_DIR=.data
PERSON_API_TOKEN=
PERSON_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# GPU worker only. Leave unset on your laptop.
WAN_REPO=
WAN_CHECKPOINT=
# Python executable in the separate upstream model environment.
WAN_PYTHON=
WAN_STEPS=20
WAN_PREVIEW_STEPS=8
# 80 GB GPU: set both to false.
WAN_OFFLOAD_MODEL=true
WAN_T5_CPU=true
# Keep the model loaded between jobs (ignored while offloading); preload it at server start.
WAN_RESIDENT=true
WAN_PRELOAD=false
WAN_MERGE_LORA=true
# Optional 4-step distill LoRA (see docs/cloud-worker.md); then use 4/6 steps.
WAN_DISTILL_LORA=
WAN_DISTILL_SCALE=1.0
WAN_TIMEOUT_SECONDS=1800


# Live mode (Lucy realtime). Server-side only; browsers get 20 s tokens. `python -m person_studio`
# loads a .env file in the project folder (shell variables win).
LIVE_MODEL=lucy-2.5
# Lucy through fal.ai (same model, billed by fal).
FAL_KEY=
FAL_LIVE_APP=decart/lucy-2-5/realtime
# Prompt assistant (writes looks from a few words, describes character photos) via fal.
ASSIST_MODEL=google/gemini-2.5-flash
ASSIST_CALLS_PER_MINUTE=12
# AI accent voices (ElevenLabs through fal) applied to saved recordings, per minute
VOICE_CALLS_PER_MINUTE=6
# Hard per-session cap (seconds, >= 10), enforced by the browser and by prepaid billing blocks.
LIVE_MAX_SESSION_SECONDS=1800
# AI accent voices: longest recording that can be converted
VOICE_MAX_SECONDS=600
# Explicit development mode omits VYRANI-added frame labels and MP4 provenance metadata.
# Provider-added marks are untouched. Keep false outside local development.
VYRA_DEV_MODE=false
# Optional RTMP/RTMPS ingest URL. Keep private in .env; never paste stream keys in the UI.
VYRA_RTMP_URL=
# Optional FFmpeg executable path (default: ffmpeg on PATH).
VYRA_FFMPEG_PATH=ffmpeg
# VYRANI · AI label (only applied when VYRA_DEV_MODE=false)
AI_LABEL=off
LIVE_TOKEN_TTL_SECONDS=20
LIVE_TOKENS_PER_MINUTE=6

# Accounts, credits and payments. With MONGO_URI set, every API route needs a signed-in user.
# MongoDB must be a replica set (Atlas is) because credit changes run in transactions.
MONGO_URI=
DB_NAME=vyra
# Public address of the app (used in email links and Stripe return URLs). https:// makes cookies Secure.
# Testing deployment: https://vyrani.blackhevents.com (legacy VYRA_PUBLIC_URL is also supported).
VYRANI_PUBLIC_URL=http://127.0.0.1:8765
# Stripe: sk_test_... while testing, sk_live_... in production (STRIPE_SECRET_TEST_KEY also works).
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8765/api/billing/webhook`, or the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI: <VYRA_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email via Resend (preferred over SMTP). Verify the sender domain in Resend first.
RESEND_API_KEY=
SMTP_FROM="VYRANI <noreply@vyrani.blackhevents.com>"
