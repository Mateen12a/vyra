{
  "manifest_version": 3,
  "name": "VYRA AI Virtual Camera & Mic",
  "version": "1.1.2",
  "description": "Exposes VYRA AI Studio's live video and voice as a Virtual Camera & Microphone in WhatsApp Web, Google Meet, Zoom Web, Discord Web, and Teams Web via local WebRTC loopback.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.vyra.ai/*",
    "https://vyra.ai/*",
    "https://web.whatsapp.com/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VYRA AI Virtual Camera",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.vyra.ai/*",
        "https://vyra.ai/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["page-inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.vyra.ai/*",
        "https://vyra.ai/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
