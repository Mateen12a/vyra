{
  "manifest_version": 3,
  "name": "VYRANI AI Virtual Camera & Mic",
  "version": "1.3.1",
  "description": "Use your VYRANI live AI look as a camera and mic in Google Meet, WhatsApp Web, Zoom, Discord and Teams on the web.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://vyrani.com/*",
    "https://www.vyrani.com/*",
    "https://vyrani.blackhevents.com/*",
    "https://web.whatsapp.com/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VYRANI AI Virtual Camera",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://vyrani.com/*",
        "https://www.vyrani.com/*",
        "https://vyrani.blackhevents.com/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "page-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://vyrani.com/*",
        "https://www.vyrani.com/*",
        "https://vyrani.blackhevents.com/*",
        "https://web.whatsapp.com/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://vyrani.com"
}
